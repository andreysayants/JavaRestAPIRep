# указывает Docker взять за основу скачанный образ с Maven 3 и Java 25
# создает внутри контейнера рабочую папку /tests и переходит в нее; все следующие команды будут выполняться именно там
# копирует все файлы проекта (включая pom.xml и папку src) с компьютера внутрь папки /tests в контейнере
# задает команду, которая запустится автоматически при старте контейнера (очистит старые сборки и прогонит тесты)

FROM maven:3-eclipse-temurin-25 
WORKDIR /tests
COPY . .
CMD ["mvn", "clean", "test"]